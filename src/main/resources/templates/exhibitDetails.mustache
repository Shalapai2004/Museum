<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>

{{> fragment}}

{{#exhibits}}
    <div>
        <h1>ID : {{id}}</h1>
        <h1>Name : {{name}}</h1>
        <h1>Description : {{description}}</h1>
